#!/bin/sh /etc/rc.common
START=96
STOP=10
USE_PROCD=1
start_service() {
 /usr/sbin/knx-uplink cleanup >/dev/null || return 1
 procd_open_instance
 procd_set_param command /bin/sh /usr/sbin/knx-uplink-loop
 procd_set_param respawn 3600 5 5
 procd_close_instance
}
stop_service() {
 /usr/sbin/knx-uplink cleanup >/dev/null
}
