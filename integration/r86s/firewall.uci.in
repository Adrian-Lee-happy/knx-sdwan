# REVIEW-ONLY fragments. Never replace the existing firewall configuration.
config zone 'knx'
 option name 'knx'
 list network 'wg_customers'
 option input 'REJECT'
 option output 'ACCEPT'
 option forward 'REJECT'

config rule 'knx_wan'
 option name 'Maintenance WireGuard listener'
 option src 'wan'
 option proto 'udp'
 option dest_port '@WG_PORT@'
 option family 'ipv4'
 option target 'ACCEPT'

config rule 'knx_ping'
 option src 'knx'
 option src_ip '@CLIENT_WG_IP@'
 option dest_ip '@SERVER_WG_IP@'
 option proto 'icmp'
 option family 'ipv4'
 option target 'ACCEPT'

config rule 'knx_customer_home'
 option name 'Private maintenance to home; requires early leased guard'
 option src 'knx'
 option dest 'lan'
 option src_ip '@PRIVATE_LAN_CIDR@'
 option dest_ip '@HOME_CIDR@'
 option proto 'all'
 option family 'ipv4'
 option target 'ACCEPT'

config rule 'knx_manage'
 option src 'lan'
 option dest 'knx'
 option src_ip '@HOME_CIDR@'
 option dest_ip '@CLIENT_WG_IP@/32'
 option proto 'tcp'
 option dest_port '22 80'
 option family 'ipv4'
 option target 'ACCEPT'

config rule 'knx_manage_ping'
 option src 'lan'
 option dest 'knx'
 option src_ip '@HOME_CIDR@'
 option dest_ip '@CLIENT_WG_IP@/32'
 option proto 'icmp'
 option family 'ipv4'
 option target 'ACCEPT'

config include 'knx_direct_reset'
 option type 'script'
 option path '/usr/sbin/knx-direct-reset'
 option fw4_compatible '1'
