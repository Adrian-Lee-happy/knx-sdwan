# REVIEW-ONLY fragments. Keep physical WAN and WWAN in existing untrusted zone.
# Existing wan zone must retain LAN->WAN forwarding and masquerade for internet.
# Never add wan->knx forwarding or an unconditional knx->wan forwarding section.
# After backup and recovery checks, merge input/forward REJECT into the EXISTING
# WAN zone. Preserve LAN->WAN forwarding/masquerade and a bounded local management
# rule while deploying. Disable unnecessary UPnP/NAT-PMP independently.
config zone 'knx'
 option name 'knx'
 list network 'wg_home'
 option input 'REJECT'
 option output 'ACCEPT'
 option forward 'REJECT'

config rule 'knx_lan_home'
 option name 'Private LAN to home; requires early leased guard'
 option src 'lan'
 option dest 'knx'
 option src_ip '@PRIVATE_LAN_CIDR@'
 option dest_ip '@HOME_CIDR@'
 option proto 'all'
 option family 'ipv4'
 option target 'ACCEPT'

config rule 'knx_home_customer'
 option src 'knx'
 option dest 'lan'
 option src_ip '@HOME_CIDR@'
 option dest_ip '@PRIVATE_LAN_CIDR@'
 option proto 'all'
 option family 'ipv4'
 option target 'ACCEPT'

config rule 'knx_management'
 option src 'knx'
 list src_ip '@HOME_CIDR@'
 list src_ip '@SERVER_WG_IP@/32'
 option dest_ip '@CLIENT_WG_IP@/32'
 option proto 'tcp'
 option dest_port '22 80'
 option family 'ipv4'
 option target 'ACCEPT'

config rule 'knx_management_ping'
 option src 'knx'
 list src_ip '@HOME_CIDR@'
 list src_ip '@SERVER_WG_IP@/32'
 option dest_ip '@CLIENT_WG_IP@/32'
 option proto 'icmp'
 option family 'ipv4'
 option target 'ACCEPT'

config include 'knx_direct_reset'
 option type 'script'
 option path '/usr/sbin/knx-direct-reset'
 option fw4_compatible '1'

# WireGuard transport only, not SSH/Web. Handles changed response source under
# same-LAN masquerade; WireGuard cryptographic peer authentication still applies.
config rule 'knx_wg_transport'
 option src 'wan'
 option proto 'udp'
 option src_port '@WG_PORT@'
 option dest_port '@CLIENT_LISTEN_PORT@'
 option family 'ipv4'
 option target 'ACCEPT'
