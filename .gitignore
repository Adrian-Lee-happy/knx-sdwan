# Real site configuration, build output and credentials never belong in Git.
/config/*
!/config/site.example.json
/build/
/dist/
/local/
/audit-local/
__pycache__/
*.pyc
.env
.env.*
*.key
*.pem
*.p12
*.pfx
id_*
authorized_keys
known_hosts
*.log
*.pcap
*.pcapng
*.tgz
*.tar
*.gz
*.zip
*.bak
*.backup
*token*
*secret*
